    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
