# Copy this file to ".env" (same folder) and paste your own free keys.
# ".env" is git-ignored. Never paste keys into chat.

# Google AI Studio → Get API key  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq console → API Keys  (https://console.groq.com/keys)
GROQ_API_KEY=

# Cloudflare dashboard → Account ID (right sidebar on the account home page)
CF_ACCOUNT_ID=
# Cloudflare → My Profile → API Tokens → Create token → "Workers AI" template
CF_API_TOKEN=

# Mistral console → API Keys  (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=qwen/qwen3.8-27b
# CF_MODEL=@cf/google/gemma-4-26b-a4b-it
# MISTRAL_MODEL=mistral-small-latest

# Required by the Worker. Set the production value with:
# npx wrangler secret put TEAM_PASSCODE
TEAM_PASSCODE=
